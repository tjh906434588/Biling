# 复制为 .env 并按需填写（LiteLLM 网关直接读取这些环境变量）
# 数据目录：数据库/日志/导入文件统一放这里（默认 ./data；桌面版由壳层 BILING_DATA_DIR 指定）
# BILING_DATA_DIR=./data
# 数据库 URL：留空则自动用 <data_dir>/biling.db；部署 PostgreSQL 时显式配置
# BILING_DATABASE_URL=sqlite:///./data/biling.db
# 模型 provider API Key（配了哪个，网关就能用哪个）
# DEEPSEEK_API_KEY=sk-xxx
# OPENAI_API_KEY=sk-xxx
# ANTHROPIC_API_KEY=sk-xxx
# DASHSCOPE_API_KEY=sk-xxx   # Qwen/通义
# 默认不配 Key 时 AI 功能直接报错并引导去「模型」页配置；设 true 可无 Key 演示 Mock 流（仅开发调试用）
# BILING_ALLOW_MOCK_WITHOUT_KEY=false
# 日志级别：DEBUG / INFO / WARNING / ERROR（调音量，默认 INFO）
# BILING_LOG_LEVEL=INFO
